{
  "name": "@fasttify/liquid-forge",
  "version": "1.0.0",
  "description": "Liquid engine for Fasttify",
  "main": "index.ts",
  "types": "index.ts",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit --declaration false --declarationMap false --rootDir ../..",
    "convert-imports": "tsx scripts/convert-imports-to-relative.ts",
    "convert-imports:dry": "tsx scripts/convert-imports-to-relative.ts --dry-run"
  },
  "dependencies": {
    "browserslist": "^4.29.1",
    "chokidar": "^4.0.3",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/cssnano": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/node-cache": "^4.2.5",
    "cssnano": "^7.1.9",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@fasttify/liquid-forge-native": "file:..\\liquid-forge-native"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda": "^3.901.0",
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/lib-storage": "^3.903.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.0",
    "liquidjs": "^10.25.0",
    "node-cache": "^5.1.2",
    "postcss": "^8.5.6",
    "uuid": "^11.1.0"
  }
