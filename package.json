{
  "name": "aws-amplify-gen2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/liquid-forge",
    "packages/orders-app",
    "packages/theme-editor",
    "packages/tenant-domains",
    "packages/theme-studio",
    "packages/liquid-forge-native"
  ],
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=20.18.3",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:quiet": "eslint . --quiet",
    "lint:check": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "test:coverage": "jest --coverage",
    "template-sync": "node scripts/template-sync.js",
    "type-check": "tsc --noEmit --incremental false",
    "type-check:fast": "tsc --noEmit --skipLibCheck",
    "clean:rust": "cargo clean --manifest-path packages/liquid-forge-native/Cargo.toml",
    "prebuild": "pnpm run clean:rust",
    "build:fast": "next build --turbopack",
    "build:full": "pnpm run type-check && pnpm run build:fast",
    "workspace:install": "pnpm install --workspaces",
    "workspace:update": "pnpm update --workspaces",
    "workspace:audit": "pnpm audit --workspaces",
    "build:packages": "pnpm run build --workspaces",
    "test:packages": "pnpm run test --workspaces",
    "lint:packages": "pnpm run lint --workspaces",
    "email:compile": "tsx scripts/compile-email-templates.ts",
    "email:test": "node scripts/test-email-system.js",
    "email:dev": "pnpm run email:compile && pnpm run email:test",
    "theme-converter:test": "tsx packages/liquid-forge/scripts/theme-converter/test/run-test.ts",
    "theme-converter:test:simple": "tsx packages/liquid-forge/scripts/theme-converter/test/simple-test.ts",
    "theme-converter:convert": "tsx packages/liquid-forge/scripts/theme-converter/cli/convert.ts",
    "analyze": "ANALYZE=true pnpm run build",
    "sandbox": "npx ampx sandbox --identifier xooty --stream-function-logs",
    "sandbox:deploy": "npx ampx deploy",
    "sandbox:logs": "npx ampx logs",
    "upload-template": "node scripts/upload-base-template.js",
    "license": "node scripts/add-license-header.js",
    "license:check": "node scripts/check-license-header.js",
    "check-build-size": "node scripts/check-build-size.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write ."
    ]
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.0",
    "@aws-amplify/data-schema-types": "^1.3.0",
    "@aws-amplify/graphql-api-construct": "^1.22.2",
    "@aws-appsync/utils": "^2.1.1",
    "@aws-sdk/client-acm": "^3.1141.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1141.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@aws-sdk/client-cloudfront": "^3.1141.0",
    "@aws-sdk/client-kms": "^3.1141.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-ses": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fasttify/liquid-forge": "workspace:*",
    "@fasttify/orders-app": "workspace:*",
    "@fasttify/tenant-domains": "workspace:*",
    "@fasttify/theme-editor": "workspace:*",
    "@fasttify/theme-studio": "workspace:*",
    "@hookform/resolvers": "3.3.4",
    "@next/bundle-analyzer": "16.3.6",
    "@polar-sh/nextjs": "^0.4.11",
    "@polar-sh/sdk": "^0.34.17",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^0.0.12",
    "@shopify/draggable": "^1.2.1",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/react-form": "^2.7.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "aws-amplify": "^6.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "eventsource": "^4.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "liquidjs": "^10.29.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "ogl": "^1.0.11",
    "pino": "^10.3.1",
    "react": "19.2.0",
    "react-currency-input-field": "^3.10.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.5.3",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "uuidv4": "^6.2.13",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@eslint/eslintrc": "^3.3.7",
    "@jest/globals": "30.5.2",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/d3-color": "^3.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/node-cache": "^4.2.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/styled-components": "^5.1.36",
    "autoprefixer": "^10.6.1",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "axios": "^1.20.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.26",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "git-format-staged": "^3.1.3",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
